{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "transparent": false,
    "centerAnchor": "omarchy.clock",
    "layout": {
      "left": [
        { "id": "omarchy.menu" },
        { "id": "omarchy.workspaces" }
      ],
      "center": [
        { "id": "omarchy.active-window" },
        { "id": "omarchy.clock", "format": "dddd HH:mm" },
        { "id": "omarchy.keyboard-layout" }
      ],
      "right": [
        { "id": "omarchy.audio" },
        { "id": "omarchy.network" },
        { "id": "omarchy.bluetooth" },
        { "id": "omarchy.monitor" },
        { "id": "omarchy.power" },
        { "id": "omarchy.tray" }
      ]
    }
  },
  "plugins": [
    { "id": "omarchy.notifications" },
    { "id": "omarchy.osd" },
    { "id": "omarchy.lock" },
    { "id": "omarchy.idle" },
    { "id": "omarchy.polkit" }
  ]
}
